# Copy to terraform.tfvars (git-ignored) and replace every placeholder.
region      = "us-east-1"
name_prefix = "acme-sqlagent-prod" # the objects bucket name derives from this: make it globally unique

hostname        = "sqlagent.example.com"
certificate_arn = "<ACM_CERTIFICATE_ARN>"     # same region, covering hostname
route53_zone_id = "<ROUTE53_HOSTED_ZONE_ID>" # or remove and CNAME hostname to load_balancer_dns_name

# Notice mail (SES), sent when someone is added to a project. New accounts start in the
# SES sandbox: request production access.
mail_domain       = "sqlagent.example.com"
mail_from_address = "sqlagent@sqlagent.example.com"

# The image tag pushed to the ecr_repositories output (git commit or release).
image_tag = "0.1.0"

# alarm_email                = "oncall@example.com"
# metrics_allowed_cidrs      = ["203.0.113.10/32"] # your Prometheus egress address
# question_failure_threshold = 10
# query_refusal_threshold    = 20
# queue_backlog_threshold    = 50

# The databases people connect (default: anywhere). Restrict to your networks:
# source_cidrs = ["10.20.0.0/16", "198.51.100.7/32"]

# A self-hosted model provider inside the VPC (Ollama, vLLM) on a port other than 443:
# ai_egress = [{ cidr = "10.0.0.0/16", port = 11434 }]

# Extra non-secret settings (see docs/guides/configuration.md).
# api_extra_environment = { WORKER_CONCURRENCY = "8", RETENTION_DAYS = "90" }
